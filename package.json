{
  "name": "dsh-landmarks",
  "version": "1.1.0",
  "type": "module",
  "description": "世界地标 3D 巡礼 + 五间安静的屋子 —— 在 DeepSeek Harness 左侧边栏打开可交互的 3D 展厅：埃菲尔铁塔、中国长城、紫禁城、泰姬陵，以及五间由散文长出来的安静房间。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeme56/dsh-landmarks.git"
  },
  "homepage": "https://github.com/zeme56/dsh-landmarks#readme",
  "icon": "./icon.svg",
  "keywords": [
    "3d",
    "blender",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "landmarks",
    "quiet-rooms",
    "three",
    "three.js"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "rooms",
    "locale",
    "docs",
    "tools",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT"
}
